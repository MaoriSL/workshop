      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "poupal-prometheus"
          },
          "editorMode": "code",
          "expr": "count(poupal:container_memory_bytes)",
          "legendFormat": "conteneurs",
