    {
      "id": 5,
      "type": "timeseries",
      "title": "Erreurs / min par service",
      "description": "Lignes error / critical par minute et par service. La série verte « aucune erreur » à 0 est l'état nominal ; les autres apparaissent dès la première erreur.",
      "datasource": {
        "type": "loki",
        "uid": "poupal-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "poupal-loki"
          },
          "editorMode": "code",
          "expr": "sum by (service) (count_over_time({level=~\"error|critical\"}[1m])) or on() label_replace(vector(0), \"service\", \"aucune erreur\", \"\", \"\")",
          "queryType": "range",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": true,
            "axisPlacement": "auto",
            "axisBorderShow": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
