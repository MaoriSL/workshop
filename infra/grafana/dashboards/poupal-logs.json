    {
      "id": 7,
      "type": "logs",
      "title": "Actions de remédiation",
      "description": "Journal des playbooks Ansible (service=remediation) : action → cible : résultat (durée) — détails. Détails complets (JSON) en dépliant une ligne.",
      "datasource": {
        "type": "loki",
        "uid": "poupal-loki"
