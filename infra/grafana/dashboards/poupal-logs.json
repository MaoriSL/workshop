  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Erreurs / min",
      "description": "Lignes de niveau error / critical sur la dernière minute, tous services.",
      "datasource": {
        "type": "loki",
        "uid": "poupal-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "poupal-loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({level=~\"error|critical\"}[1m]))",
          "queryType": "instant",
          "legendFormat": "erreurs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
