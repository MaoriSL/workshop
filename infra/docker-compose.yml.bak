# ------------------------------------------------------------------
# Poupal — plateforme de paiement FICTIVE (démonstrateur Resilience-Alpha)
# Lancement : cd infra && docker compose up -d --build
# Pré-requis : infra/.env (copie de .env.example) et scripts/gen_keys.sh (clés JWT dans secrets/).
# Seule la gateway publie un port sur l'hôte ; db / auth / api restent sur le réseau interne.
# ------------------------------------------------------------------
name: poupal

services:
  db:
    image: postgres:16-alpine
    container_name: poupal-db
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-poupal}
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?POSTGRES_PASSWORD manquant dans infra/.env}
      AUTH_DB_PASSWORD: ${AUTH_DB_PASSWORD:?AUTH_DB_PASSWORD manquant dans infra/.env}
      API_DB_PASSWORD: ${API_DB_PASSWORD:?API_DB_PASSWORD manquant dans infra/.env}
    volumes:
      - db-data:/var/lib/postgresql/data
      - ./db/init:/docker-entrypoint-initdb.d:ro   # rôles + schémas, exécuté au premier démarrage
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-poupal}"]
      interval: 5s
      timeout: 3s
      retries: 10
    networks: [backend]
    restart: unless-stopped

  auth:
    build:
      context: ../services/auth
      target: runtime
    container_name: poupal-auth
    environment:
      SERVICE_NAME: poupal-auth
      DATABASE_URL: postgresql+psycopg://poupal_auth:${AUTH_DB_PASSWORD}@db:5432/${POSTGRES_DB:-poupal}
      JWT_PRIVATE_KEY_PATH: /run/secrets/jwt_private.pem
      JWT_PUBLIC_KEY_PATH: /run/secrets/jwt_public.pem
      JWT_ISSUER: ${JWT_ISSUER:-poupal-auth}
      JWT_EXPIRES_MINUTES: ${JWT_EXPIRES_MINUTES:-30}
      CORS_ORIGINS: ${CORS_ORIGINS:-http://localhost:8080}
      LOGIN_RATE_LIMIT: ${LOGIN_RATE_LIMIT:-5/60}
      SEED_DEMO_DATA: ${SEED_DEMO_DATA:-false}
      DEMO_PASSWORD: ${DEMO_PASSWORD:-}
      LOG_LEVEL: ${LOG_LEVEL:-INFO}
    secrets:
      - jwt_private.pem
      - jwt_public.pem
    depends_on:
      db: { condition: service_healthy }
    expose: ["8001"]
    networks: [backend]
    restart: unless-stopped

  api:
    build:
      context: ../services/api
      target: runtime
    container_name: poupal-api
    environment:
      SERVICE_NAME: poupal-api
      DATABASE_URL: postgresql+psycopg://poupal_api:${API_DB_PASSWORD}@db:5432/${POSTGRES_DB:-poupal}
      JWT_PUBLIC_KEY_PATH: /run/secrets/jwt_public.pem
      JWT_ISSUER: ${JWT_ISSUER:-poupal-auth}
      CORS_ORIGINS: ${CORS_ORIGINS:-http://localhost:8080}
      TRANSACTION_RATE_LIMIT: ${TRANSACTION_RATE_LIMIT:-10/60}
      MAX_TRANSACTION_CENTS: ${MAX_TRANSACTION_CENTS:-500000}
      DEMO_INITIAL_BALANCE_CENTS: ${DEMO_INITIAL_BALANCE_CENTS:-100000}
      SEED_DEMO_DATA: ${SEED_DEMO_DATA:-false}
      LOG_LEVEL: ${LOG_LEVEL:-INFO}
    secrets:
      - jwt_public.pem          # clé PUBLIQUE uniquement : l'API ne peut pas signer de jeton
    depends_on:
      db: { condition: service_healthy }
      auth: { condition: service_healthy }   # la vue auth.user_directory doit exister
    expose: ["8000"]
    networks: [backend]
    restart: unless-stopped

  front:
    build:
      context: ../frontend/poupal
      args:
        VITE_API_URL: ""          # même origine que la gateway (/auth, /api)
        VITE_USE_MOCK: "false"
    container_name: poupal-front
    expose: ["80"]
    networks: [backend]
    restart: unless-stopped

  gateway:
    image: nginx:1.27-alpine
    container_name: poupal-gateway
    volumes:
      - ./gateway/nginx.conf:/etc/nginx/conf.d/default.conf:ro
    ports:
      - "${GATEWAY_PORT:-8080}:80"   # SEUL port publié sur l'hôte
    depends_on:
      auth: { condition: service_healthy }
      api: { condition: service_healthy }
      front: { condition: service_started }
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1/gateway/health >/dev/null 2>&1 || exit 1"]
      interval: 10s
      timeout: 3s
      retries: 3
    networks: [backend]
    restart: unless-stopped

# Clés JWT générées par scripts/gen_keys.sh, montées en lecture seule dans /run/secrets/
secrets:
  jwt_private.pem:
    file: ../secrets/jwt_private.pem
  jwt_public.pem:
    file: ../secrets/jwt_public.pem

volumes:
  db-data:

networks:
  backend:
    driver: bridge
