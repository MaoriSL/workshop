# Base URL de l'API de l'orchestrateur d'attaques (même origine que la console).
# Par défaut : /api  (en dev, le proxy Vite transmet /api vers http://localhost:8099).
VITE_API_BASE=/api

# true : scénarios et runs de démonstration embarqués (badge « démo »), aucun réseau.
# Vide ou false : appels réels à l'orchestrateur.
VITE_USE_MOCK=
