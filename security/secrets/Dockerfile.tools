# Outils de gestion des secrets : SOPS (chiffrement structuré) + age (chiffrement par clé).
# Image utilitaire, lancée à la demande par scripts/secrets.sh — ne tourne pas en permanence.
FROM alpine:3.21
RUN apk add --no-cache age bash
COPY --from=ghcr.io/getsops/sops:v3.9.4 /usr/local/bin/sops /usr/local/bin/sops
WORKDIR /workspace
ENTRYPOINT ["/bin/bash"]
