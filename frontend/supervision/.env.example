# Base URL de l'API du moteur de remédiation (même origine, proxifiée par la gateway).
# Par défaut : /supervision/api
VITE_API_BASE=/supervision/api

# true : données de démonstration embarquées (incident rejoué en boucle, badge « démo »).
# Vide ou false : appels réels au moteur de remédiation.
VITE_USE_MOCK=
