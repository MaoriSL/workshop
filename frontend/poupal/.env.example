# Origine de la gateway Poupal (ex. http://localhost:8080) ; les chemins /auth et /api s'y ajoutent.
# Vide = même origine que le site. Sans VITE_USE_MOCK=false, une URL vide = données factices (mode démo).
VITE_API_URL=

# true : forcer les données factices ; false : forcer les vrais appels (même avec une URL vide).
VITE_USE_MOCK=
